# Telegram bot token created with @BotFather.
BOT_TOKEN=

# Telegram numeric ID of the only administrator allowed to review payments.
ADMIN_TELEGRAM_ID=

# C³ CELERITY panel URL. Do not add /api here.
CELERITY_BASE_URL=https://whitelist.soon.it

# A dedicated Celerity API key for this shop bot only.
# Minimum scopes: users:read, users:write.
CELERITY_API_KEY=

# Use "bearer" for Authorization: Bearer ck_... (the existing ops bot uses this).
# Use "x-api-key" only if the panel is configured for that header.
CELERITY_AUTH_MODE=bearer
CELERITY_TIMEOUT_SECONDS=30

# Manual bank-transfer details. These values are never written to technical logs.
PAYMENT_CARD=
PAYMENT_CARD_HOLDER=

# Without the leading @, for example support_username.
SUPPORT_USERNAME=

# Durable application data inside the container.
DATABASE_PATH=/app/data/shop.db
LOG_FILE_PATH=/app/logs/vpn-shop-bot.log
LOG_LEVEL=INFO